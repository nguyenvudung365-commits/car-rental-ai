# Car Rental AI - Environment Variables Template
# Copy to .env and fill real values (NEVER commit .env)

# Database
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CarRentalDB
DB_USER=sa
DB_PASSWORD=CHANGE_ME_Strong!Pass123

# JWT Secret (min 32 chars)
JWT_KEY=CHANGE_ME_at_least_32_random_characters_here

# AI Service
AI_SERVICE_URL=http://localhost:5002
AI_TIMEOUT_SECONDS=2
AI_RETRY_COUNT=2

# Gemini API (for AI chatbot)
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key_here

# MinIO Object Storage (ảnh xe — chỉ chấp nhận WebP)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=car-rental
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# CORS (development)
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=Information
